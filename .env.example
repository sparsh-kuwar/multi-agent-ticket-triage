# Optional. Without a key the app uses its rule-based agents.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to false to force rule-based mode even when a key is present.
TRIAGE_USE_LLM=true
LLM_TIMEOUT_SECONDS=20
# Load six sample tickets on startup so the queue is not empty.
SEED_SAMPLE_TICKETS=true
